# Copy to .env and fill in.

NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://localhost:5432/portal_app_dev?schema=public"

# Signs this app's own session cookie. Independent of admin-service's session secret.
SESSION_SECRET=

# admin-service connection
ADMIN_SERVICE_URL=http://localhost:4000
# Must match admin-service's INTERNAL_API_KEY exactly.
ADMIN_SERVICE_INTERNAL_API_KEY=
# Must match admin-service's INTERNAL_JWT_SECRET exactly.
ADMIN_SERVICE_JWT_SECRET=

APP_BASE_URL=http://localhost:5000
