<!doctype html>
<html>
<head><%- include('partials/head', { title: 'Home' }) %></head>
<body>
  <%- include('partials/nav', { currentUser, canViewAuditLog }) %>
  <div class="app-shell">
    <div class="page-header"><h1>Welcome, <%= currentUser.name %></h1></div>
    <% if (currentUser.role === 'investor') { %>
      <p style="color:#5b6270;">Your documents will appear here once document upload and the investor dashboard are built (build order steps 3–4).</p>
    <% } else { %>
      <p style="color:#5b6270;">Signed in as <strong><%= currentUser.role %></strong>. Document upload, assignment, and Dropbox sync land in the next build steps.</p>
    <% } %>
    <p class="helptext">You're signed in via the shared admin-service directory. Account/role management for investor-portal users happens in admin-service's admin panel.</p>
  </div>
</body>
</html>
