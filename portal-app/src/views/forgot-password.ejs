<!doctype html>
<html>
<head><%- include('partials/head', { title: 'Forgot password' }) %></head>
<body>
  <div class="auth-shell">
    <div class="card">
      <h1>Reset your password</h1>
      <% if (submitted) { %>
        <p class="subtitle">If that email has an account, a reset link is on its way. It expires in 1 hour.</p>
        <div class="links"><a href="/login">Back to sign in</a></div>
      <% } else { %>
        <p class="subtitle">We'll email you a link to reset your password.</p>
        <form method="post" action="/forgot-password">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autofocus />
          <button type="submit">Send reset link</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>
