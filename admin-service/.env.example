# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL="postgresql://localhost:5432/admin_service_dev?schema=public"

# Signs the admin UI's own browser session cookie. 32+ random bytes.
SESSION_SECRET=

# Signs short-lived identity assertions handed back to calling apps (e.g. portal-app)
# after a successful login+MFA. Must be shared (out of band) with every app that
# needs to verify these tokens. 32+ random bytes.
INTERNAL_JWT_SECRET=

# Shared secret that other services (e.g. portal-app) must send as the
# `x-internal-api-key` header to call /internal/* endpoints.
INTERNAL_API_KEY=

# 32-byte (64 hex char) key used to encrypt TOTP secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# --- SMS MFA (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Transactional email (password reset) ---
# EMAIL_PROVIDER=console logs reset links to the server console instead of sending
# real email. Safe for local dev only; refuses to start with EMAIL_PROVIDER=console
# when NODE_ENV=production.
EMAIL_PROVIDER=console
EMAIL_FROM="Michael's Company <no-reply@example.com>"
POSTMARK_API_KEY=

# Base URL this service is reachable at, used to build password-reset links.
APP_BASE_URL=http://localhost:4000

# Where each app that authenticates against this service is reachable, so
# account-setup/password-reset emails link to that app's own branded pages instead of
# admin-service's. Read only by `npm run seed` (see prisma/seed.ts and
# src/config/applications.ts). Add one of these per app as it's registered.
INVESTOR_PORTAL_BASE_URL=http://localhost:5000
