<!doctype html>
<html>
<head><%- include('partials/head', { title: 'Sign in' }) %></head>
<body>
  <div class="auth-shell">
    <div class="card">
      <h1>Sign in</h1>
      <p class="subtitle">Admin Service</p>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="post" action="/login">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus value="<%= email || '' %>" />
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />
        <button type="submit">Continue</button>
      </form>
      <div class="links"><a href="/forgot-password">Forgot password?</a></div>
    </div>
  </div>
</body>
</html>
